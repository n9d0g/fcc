{
	"name": "web",
	"version": "3.25.0",
	"private": true,
	"author": "Nathan Lardizabal <nate@njil.dev>",
	"maintainers": [
		"Nathan Lardizabal <nate@njil.dev>"
	],
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "vite dev --host",
		"dev:all": "pnpm -r --parallel --include-workspace-root dev",
		"build": "svelte-kit sync && vite build",
		"preview": "pnpm build && wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test tests",
		"test:ui": "playwright test --ui",
		"test:unit": "vitest",
		"lint": "oxfmt --check && eslint .",
		"format": "oxfmt",
		"clean": "rm -rf node_modules pnpm-lock.yaml .svelte-kit apps/cms/node_modules apps/cms/dist apps/cms/.sanity",
		"fresh": "pnpm format && pnpm clean && pnpm install",
		"fresh:start": "pnpm fresh && pnpm dev",
		"cms:dev": "pnpm --filter cms dev",
		"cms:build": "pnpm --filter cms build",
		"cms:deploy": "pnpm --filter cms run deploy",
		"unlighthouse": "pnpm dlx unlighthouse --site fcccanada.ca",
		"unlighthouse:dev": "pnpm dlx unlighthouse --site dev.fcccanada.ca"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@sanity/client": "^7.23.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.7",
		"@sveltejs/adapter-cloudflare": "^7.0.4",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.2",
		"date-fns": "^4.4.0",
		"resend": "^6.17.2",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-youtube-embed": "^0.4.6",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@types/node": "^26.1.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.35.0",
		"typescript-eslint": "^8.62.1",
		"vitest": "^4.1.9",
		"wrangler": "^4.42.0"
	},
	"packageManager": "pnpm@10.30.3"
}
