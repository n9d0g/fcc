{
	"name": "web",
	"version": "3.32.11",
	"private": true,
	"author": "Nathan Lardizabal <nate@njil.dev>",
	"maintainers": [
		"Nathan Lardizabal <nate@njil.dev>"
	],
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "vp config && svelte-kit sync || echo ''",
		"dev": "vp dev --host",
		"dev:all": "vp run -r --parallel --log labeled dev",
		"build": "svelte-kit sync && vp build",
		"preview": "vp run build && wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp run cms#check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test tests",
		"test:ui": "playwright test --ui",
		"test:unit": "vp test",
		"lint": "vp check",
		"format": "vp check --fix",
		"clean": "rm -rf node_modules pnpm-lock.yaml .svelte-kit apps/cms/node_modules apps/cms/dist apps/cms/.sanity",
		"fresh": "vp run format && vp run clean && pnpm install",
		"fresh:start": "vp run fresh && vp dev --host",
		"cms:dev": "vp run cms#dev",
		"cms:build": "vp run cms#build",
		"cms:deploy": "vp run cms#deploy",
		"email:deploy": "wrangler deploy --config apps/email-worker/wrangler.jsonc",
		"unlighthouse": "pnpm dlx unlighthouse --site fcccanada.ca",
		"unlighthouse:dev": "pnpm dlx unlighthouse --site dev.fcccanada.ca"
	},
	"dependencies": {
		"@better-svelte-email/components": "^2.3.0",
		"@better-svelte-email/server": "^2.3.0",
		"@iconify/svelte": "^5.2.3",
		"@sanity/client": "^8.14.1",
		"@sentry/cloudflare": "^11.10.0",
		"@sentry/sveltekit": "^11.10.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"date-fns": "^4.4.0",
		"resend": "^6.37.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"three": "^0.187.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"vite-plus": "catalog:",
		"wrangler": "^4.156.0"
	},
	"packageManager": "pnpm@12.17.0"
}
