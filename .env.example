# Key list only. Locally, `.env` is mounted by the 1Password environment
# (a named pipe, not a regular file); see docs/adr/0002. Without 1Password
# access, copy this file to `.env` and fill in values from a maintainer.

# Public (required at build time for CI and local dev)
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_ANON_KEY=""
PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=""
# Sentry → Project Settings → Client Keys (DSN). Leave empty to disable Sentry.
PUBLIC_SENTRY_DSN=""
# production | qa | development (defaults to development when unset)
PUBLIC_SENTRY_ENVIRONMENT="development"

# CI only: source map upload. Leave these out locally. vite.config.js reads them
# from process.env, which `.env` doesn't populate. Set as GitHub Actions secrets
# (SENTRY_AUTH_TOKEN) and variables (SENTRY_ORG, SENTRY_PROJECT).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Private: `wrangler dev` / `pnpm preview` reads these from `.env`. Don't create
# a `.dev.vars` file; it would override `.env`. For deployed environments, set
# them as Worker secrets in Cloudflare (`wrangler secret put …`).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@fcccanada.ca"
GOOGLE_RECAPTCHA_SECRET_KEY=""
# Supabase → Project Settings → API → service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Any long random string; also set as the "Authorization: Bearer …" header on
# the Sanity webhook that calls /api/sanity/events
SANITY_WEBHOOK_SECRET=""
# Any long random string; also a GitHub Actions secret of the same name, used by
# .github/workflows/prayer-reminders.yml to call /api/cron/prayer-reminders
CRON_SECRET=""
